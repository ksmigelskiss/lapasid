rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────
    // ADMIN HELPER
    // ──────────────────────────────────────────────────────────────
    // Tikrina ar request.auth user'is turi `isAdmin: true` users/{uid}
    // dokumente. Naudojama allow rules'uose kaip override'as visiems
    // ribojimams. Tavo paskyrai (kestutis@okone.lt) reikia per Firebase
    // Console rankiniu būdu pridėti `isAdmin: true` lauką users doc'e.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ──────────────────────────────────────────────────────────────
    // USERS
    // ──────────────────────────────────────────────────────────────
    // Įprastai — tik savo doc'as.
    // Admin'as — read'as (vartotojų sąrašas) + write'as (toggle
    // isAdmin / beta / subscription / approved per AdminPanel) +
    // delete (reject pending users'ams ir soft delete vartotojams).
    match /users/{uid} {
      allow read, write, delete: if request.auth != null && (
        request.auth.uid == uid ||
        isAdmin()
      );
    }

    // ──────────────────────────────────────────────────────────────
    // COLLECTIONS
    // ──────────────────────────────────────────────────────────────
    // Read/write/delete — tik members'ams arba admin'ui.
    // (Admin delete — soft delete user cascade'ui, kai trinam jo owned
    // kolekcijas.)
    // Create — bet kuriam auth'intam (naujos kolekcijos kūrimui).
    // Update — papildomas case'as: ne-member gali update'inti tik jei
    // prideda SAVE į members[] (accept invite flow'as) — ta logika
    // palikta nepakitusi, plius admin override'as.
    match /collections/{colId} {
      allow read, write, delete: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        isAdmin()
      );

      allow create: if request.auth != null;

      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        isAdmin() ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.hasAll([request.auth.uid])
        )
      );
    }

    // ──────────────────────────────────────────────────────────────
    // COLLECTION PLANTS (subkolekcija)
    // ──────────────────────────────────────────────────────────────
    // Members'ai — pilnos teisės (read + write).
    // Admin'as — TIK read (kolekcijos statistikai, plant count) ir
    // TIK delete (cascade kai soft-delete user'į). NE write — tavo
    // privatumo principas: admin'as plant content'o neredaguoja.
    match /collections/{colId}/plants/{plantId} {
      allow read: if request.auth != null && (
        request.auth.uid in get(/databases/$(database)/documents/collections/$(colId)).data.members ||
        isAdmin()
      );
      allow write: if request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/collections/$(colId)).data.members;
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // CATALOG (bendra rūšių žinių bazė — cultivar / standalone records)
    // ──────────────────────────────────────────────────────────────
    // Visi prisijungę gali skaityti ir rašyti (saveToCatalog
    // automatiškai per syncFromRemote). Vėliau, kai pridėsim
    // moderation'ą, write'us apribosim į admin/moderator.
    match /catalog/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ──────────────────────────────────────────────────────────────
    // TAXON GROUPS (cultivar serijos, species, hybrid'ai, genus-care
    // ir kt. parent grouping'ai — shared care info per N cultivars)
    // ──────────────────────────────────────────────────────────────
    // Visi prisijungę skaito (user'iai mato seriją per merge'inta info).
    // Write — tik admin'ams (kuris bulk save'ina ar update'ina shared
    // care info). User'ių klientai negali sukurti / pakeisti tax grupių.
    match /taxonGroups/{groupId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // INVITES (collection sharing token'ai)
    // ──────────────────────────────────────────────────────────────
    // Read/create/update — bet kuriam auth'intam (accept invite flow'as).
    // Delete — tik admin'ui (invite cleanup tab admin panel'e).
    match /invites/{token} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────
    // PLANT PASSPORTS (viešos augalo „paso" puslapiai)
    // ──────────────────────────────────────────────────────────────
    match /plant-passports/{plantId} {
      allow read:  if resource.data.isPublic == true || request.auth != null;
      allow write: if request.auth != null;
    }

    // ──────────────────────────────────────────────────────────────
    // PLANT SITTER TOKENS (viewer share link'ai be auth'o)
    // ──────────────────────────────────────────────────────────────
    match /plant-sitter-tokens/{token} {
      allow read:  if true;
      allow write: if request.auth != null;
    }
  }
}
