rules_version = '2';

// ──────────────────────────────────────────────────────────────────────
// Firebase Storage rules — lapasid (geliu-db projektas)
// ──────────────────────────────────────────────────────────────────────
//
// 2026-06-02 — VERSION-CONTROLLED kopija dabartinių Console taisyklių.
// Security audit flagino „no storage.rules file" kaip gap'ą, BET tai buvo
// REPO gap (failo nebuvo versijų kontrolėje), NE security gap — Console'je
// taisyklės egzistavo ir yra sound'ios. Šis failas dabar atspindi deployed
// reality. DEPLOY (jei keisi) = manual Console (nėra firebase.json CLI deploy).
//
// ── Ką šios taisyklės dengia ──────────────────────────────────────────
//   • plants/** — user augalų foto. Authed read+write. Client upload'ina čia
//     (uploadImageWithThumb). Reads dažnai per getDownloadURL token-URL'ą
//     (bypass'ina rules), bet SDK read'ui taip pat auth.
//   • catalog/* — hero iliustracijos. NĖRA explicit match → DEFAULT DENY SDK
//     prieigai. BET:
//       - server (generate-hero / save-plant / rehost-image per admin SDK)
//         BYPASS'ina rules → hero gen veikia
//       - user'iai mato hero per makePublic() public URL (storage.googleapis.com)
//         → public HTTP GET, NE Firebase SDK, rules netaikomos
//     Tad client'as NEGALI rašyti į catalog/* (default deny) — overwrite-hero
//     gap'as uždarytas. Reads veikia per public URL.
//   • Bet koks kitas path — DEFAULT DENY (Firebase Storage rules_version 2
//     default'as unmatched path'ams). „Open storage" uždaryta.
//
// ── ŽINOMA LIMITACIJA ─────────────────────────────────────────────────
//   plants/{plantId} path neturi colId, tad rule NEGALI verifikuoti, ar
//   authed user valdo plantId → bet kuris authed user gali skaityti/rašyti
//   bet kurią plant foto (jei žino plantId). Struktūrinis apribojimas.
//   Future fix: path → collections/{colId}/plants/{plantId}/* + members check
//   per firestore.get(). Demo stage'e priimtina (mažai user'ių, plantId ne
//   guessable, foto ne sensityvi).

service firebase.storage {
  match /b/{bucket}/o {
    match /plants/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
