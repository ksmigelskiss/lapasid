# Kliento (VITE_) kintamieji — visi NEPRIVALOMI lokaliam dev'ui.
# API raktai (Anthropic, Brave, Firebase admin) gyvena TIK Vercel env —
# jie naudojami api/ serverless funkcijose, NIEKADA kliento bundle.

# Sentry klaidos (be šito — monitoring tiesiog išjungtas)
# VITE_SENTRY_DSN=

# Mock user režimas (dev playgrounds per ?playground=...)
# VITE_USE_MOCK_USER=true

# Server-side save flow (production'e įjungtas per Vercel env)
# VITE_USE_SERVERSIDE_SAVE=true
